{
  "_version": "1.65.0",
  "sap.app": {
    "id": "inquiry",
    "type": "application",
    "title": "問い合わせ入力",
    "description": "問い合わせ受付フォーム",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "InquiryService": {
        "uri": "/odata/v4/InquiryService/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": false
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "inquiry.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.layout": {}
      }
    },
    "models": {
      "": {
        "dataSource": "InquiryService",
        "settings": { "synchronizationMode": "None", "operationMode": "Server" }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "controlId": "appControl",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        { "name": "form",    "pattern": "",                    "target": "form" },
        { "name": "success", "pattern": "success/{inquiryNo}", "target": "success" }
      ],
      "targets": {
        "form":    { "viewName": "inquiry.view.InquiryForm",   "viewLevel": 1 },
        "success": { "viewName": "inquiry.view.SubmitSuccess", "viewLevel": 2 }
      }
    }
  }
}
