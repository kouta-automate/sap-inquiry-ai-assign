# ========================================================
# AI切替フラグ
#   true  = パターンB（モック）→ BTPアカウント不要
#   false = パターンA（Generative AI Hub）→ 以下の設定が必要
# ========================================================
USE_MOCK_AI=true

# ========================================================
# パターンA: SAP AI Core サービスキー
#   BTP → AI Core インスタンス → サービスキー作成 → JSONをそのまま貼り付け
#   例: AICORE_SERVICE_KEY={"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}
# ========================================================
AICORE_SERVICE_KEY=

# ========================================================
# パターンA: 使用するLLMモデル名（省略時: gpt-4o）
#   AI Launchpad で Generative AI Hub → デプロイ済みモデルを確認
#   例: gpt-4o / gpt-4 / gpt-35-turbo / mistral-large-latest
# ========================================================
AICORE_MODEL_NAME=gpt-4o

# ========================================================
# パターンA: リソースグループ（省略時: default）
# ========================================================
# AICORE_RESOURCE_GROUP=default

# ========================================================
# Slack Incoming Webhook URL
#   Slack アプリ → Incoming Webhooks → Webhook URL をそのまま貼り付け
#   未設定時は通知をスキップ（承認処理には影響しない）
# ========================================================
SLACK_WEBHOOK_URL=
